{
  "name": "doppiojvm",
  "version": "0.6.0",
  "description": "A modern Java compatibility fork of the TypeScript DoppioJVM runtime.",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "yarn@1.22.22",
  "license": "MIT",
  "homepage": "https://seorii.page/doppio/",
  "main": "dist/release-cli/src/doppiojvm.js",
  "browser": "dist/release/doppio.js",
  "types": "types/public.d.ts",
  "files": [
    "CHANGELOG.md",
    "bin",
    "dist",
    "docs/README.md",
    "docs/modern-java.md",
    "docs/support.md",
    "install.js",
    "prepack.cjs",
    "types/public.d.ts"
  ],
  "dependencies": {
    "async": "^2.0.0",
    "browserfs": "1.3.0",
    "glob": "^7.1.1",
    "gunzip-maybe": "^1.3.1",
    "pako": "^1.0.3",
    "rimraf": "^2.5.4",
    "source-map-support": "^0.4.3",
    "tar-fs": "^1.13.2"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "5.0.5",
    "@types/async": "2.4.2",
    "@types/body-parser": "0.0.33",
    "@types/dropboxjs": "0.0.29",
    "@types/esprima": "^2.1.33",
    "@types/express": "^4.0.33",
    "@types/express-serve-static-core": "^4.0.37",
    "@types/filesystem": "0.0.28",
    "@types/glob": "^5.0.30",
    "@types/grunt": "0.4.32",
    "@types/jasmine": "2.5.35",
    "@types/karma": "^0.13.33",
    "@types/node": "6.0.33",
    "@types/rimraf": "0.0.28",
    "@types/semver": "^5.3.30",
    "@types/serve-static": "^1.7.31",
    "@types/source-map": "^0.1.28",
    "@types/uglify-js": "^2.6.28",
    "@types/underscore": "^1.7.33",
    "@types/webpack": "^1.12.35",
    "body-parser": "^1.15.2",
    "cpr": "^2.0.0",
    "detect-browser": "^1.3.1",
    "escodegen": "^1.8.1",
    "esprima": "^3.1.0",
    "estraverse": "^4.2.0",
    "express": "^4.13.4",
    "grunt": "^1.0",
    "grunt-cli": "^1.2",
    "grunt-contrib-compress": "^1.2.0",
    "grunt-contrib-connect": "^1.0",
    "grunt-contrib-copy": "^1.0",
    "grunt-contrib-uglify": "5.2.2",
    "grunt-karma": "^2.0",
    "grunt-lineending": "^1.0.0",
    "grunt-merge-source-maps": "^0.1.0",
    "grunt-newer": "^1.2.0",
    "grunt-ts": "6.0.0-beta.22",
    "grunt-webpack": "^1.0.17",
    "imports-loader": "^0.6.5",
    "jasmine-core": "^2.5.2",
    "json-loader": "^0.5.4",
    "karma": "^1.3.0",
    "karma-chrome-launcher": "^2.0",
    "karma-firefox-launcher": "^1.0",
    "karma-ie-launcher": "^1.0",
    "karma-jasmine": "^1.0",
    "karma-opera-launcher": "^1.0",
    "karma-safari-launcher": "^1.0",
    "locate-java-home": "1.1.1",
    "marked": "15.0.12",
    "playwright": "1.57.0",
    "semver": "^5.3.0",
    "source-map-loader": "^0.1.5",
    "typescript": "6.0.3",
    "uglify-js": "3.19.3",
    "underscore": "^1.12.1",
    "vite": "4.5.14",
    "webpack": "^1.13.1",
    "webpack-dev-server": "^1.16.2"
  },
  "scripts": {
    "test": "grunt test",
    "prepack": "node ./prepack.cjs",
    "install": "node ./install.js",
    "appveyor-test": "grunt --stack test-browser-appveyor",
    "site:browser-test": "node ci/pages_browser_smoke.mjs",
    "site:build": "vite build --config vite.site.config.mjs",
    "site:check": "node ci/check_pages_site.mjs",
    "ci:check-pages-workflow": "node ci/check_pages_workflow.mjs",
    "ci:check-pages-workflow:test": "node ci/check_pages_workflow_test.mjs",
    "ci:check-modern-java-workflow": "node ci/check_modern_java_workflow.mjs",
    "ci:check-modern-java-workflow:test": "node ci/check_modern_java_workflow_test.mjs",
    "ci:java-compatibility:prepare": "node ci/prepare_java_compatibility_toolchains.mjs",
    "ci:java-compatibility:test": "node --test ci/prepare_java_compatibility_toolchains_test.mjs ci/run_java_compatibility_test.mjs ci/java_compatibility_browser_test.mjs",
    "ci:java-compatibility": "node ci/run_java_compatibility.mjs",
    "ci:java-compatibility:browser": "node ci/run_java_compatibility.mjs --browser",
    "ci:phase-a:inventory": "node ci/plan_spec_source_index.mjs --check && node ci/check_java_se_api_census.mjs && node ci/java_se_contract_sources.mjs && node ci/check_phase_a_inventory.mjs",
    "ci:phase-a:test": "node --test ci/plan_spec_source_index_test.mjs ci/check_java_se_api_census_test.mjs ci/java_se_contract_sources_test.mjs ci/check_plan_spec_obligations_test.mjs ci/check_phase_a_inventory_test.mjs ci/check_phase_a_evidence_test.mjs",
    "ci:phase-a:evidence": "node ci/check_phase_a_evidence.mjs",
    "ci:java-initialization:test": "node --test ci/class_initialization_test.cjs ci/interface_invocation_initialization_test.cjs ci/java_initialization_contract_test.mjs",
    "ci:java-initialization": "node ci/run_java_compatibility.mjs --manifest ci/java_initialization_manifest.json --output build/java-initialization-results.json --browser",
    "ci:class-structure:test": "node --test ci/class_member_structure_test.cjs ci/class_attribute_structure_test.cjs ci/java_class_structure_contract_test.mjs",
    "ci:class-structure": "node ci/java_class_structure_test.mjs --browser",
    "ci:bytecode-verification:test": "node --test ci/bytecode_structure_test.cjs ci/bytecode_type_test.cjs ci/verification_relations_test.cjs ci/verification_exception_boundary_test.cjs ci/class_verification_test.cjs ci/verification_loader_failure_test.cjs ci/class_verification_integration_test.cjs ci/modern_overlay_verification_test.cjs ci/unsafe_allocation_verification_test.cjs ci/reflection_invocation_verification_test.cjs ci/lambda_verification_test.cjs ci/reflection_adapters_test.cjs ci/java_bytecode_verification_contract_test.mjs",
    "ci:bytecode-verification": "node ci/java_bytecode_verification_test.mjs --browser",
    "ci:class-derivation:test": "node --test ci/class_derivation_test.cjs ci/class_loader_derivation_test.cjs ci/lookup_class_metadata_test.cjs ci/java_class_derivation_contract_test.mjs",
    "ci:class-derivation": "node ci/java_class_derivation_test.mjs --browser",
    "ci:loading-constraints:test": "node --test ci/loading_constraints_test.cjs ci/class_loading_constraints_test.cjs ci/member_loading_constraints_test.cjs ci/class_preparation_test.cjs ci/method_selection_test.cjs ci/java_loading_constraints_contract_test.mjs",
    "ci:loading-constraints": "node ci/java_loading_constraints_test.mjs --browser",
    "ci:member-resolution:test": "node --test ci/class_member_resolution_test.cjs ci/java_member_resolution_contract_test.mjs",
    "ci:member-resolution": "node ci/java_member_resolution_test.mjs --browser",
    "ci:member-access:test": "node --test ci/symbolic_resolution_test.cjs ci/class_access_test.cjs ci/java_member_access_contract_test.mjs",
    "ci:member-access": "node ci/java_member_access_test.mjs --browser",
    "ci:java25-main": "node ci/java25_main_test.mjs --browser",
    "ci:java-uncaught-exit": "node ci/java_uncaught_exit_test.mjs --browser",
    "ci:java-uncaught-exit:test": "node ci/jvm_exit_status_test.cjs && node --test ci/java_uncaught_exit_contract_test.mjs",
    "ci:class-file-version:test": "node ci/class_file_version_test.cjs && node --test ci/java_class_version_test_test.mjs",
    "ci:class-file-version": "node ci/java_class_version_test.mjs --browser",
    "ci:java-pattern-evolution": "node ci/java_pattern_evolution_test.mjs --browser",
    "ci:java-pattern-evolution:test": "node --test ci/java_pattern_evolution_contract_test.mjs",
    "ci:check-compiler-bootstrap-consumers": "node ci/check_compiler_bootstrap_consumers.mjs",
    "ci:check-compiler-bootstrap-consumers:test": "node ci/check_compiler_bootstrap_consumers_test.mjs",
    "ci:check-kotlin-modern-source-guards": "node ci/check_kotlin_modern_source_guards.mjs",
    "ci:check-kotlin-modern-source-guards:test": "node ci/check_kotlin_modern_source_guards_test.mjs",
    "ci:check-scala-modern-source-guards": "node ci/check_scala_modern_source_guards.mjs",
    "ci:check-scala-modern-source-guards:test": "node ci/check_scala_modern_source_guards_test.mjs",
    "ci:check-package-artifact": "node ci/package_artifact_smoke.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:bootstrap": "tsc --noEmit --ignoreConfig --noImplicitAny --noImplicitThis false --strict false --strictNullChecks false --strictPropertyInitialization false --useUnknownInCatchVariables false --module commonjs --target ES2015 --skipLibCheck types/legacy-globals.d.ts tasks/*.ts Grunttasks.ts",
    "typecheck:typescript-7-rc": "npx -y -p typescript@7.0.1-rc tsc --project tsconfig.json --noEmit",
    "typecheck:typescript-7-rc-bootstrap": "npx -y -p typescript@7.0.1-rc tsc --noEmit --ignoreConfig --noImplicitAny --noImplicitThis false --strict false --strictNullChecks false --strictPropertyInitialization false --useUnknownInCatchVariables false --module commonjs --target ES2015 --skipLibCheck types/legacy-globals.d.ts tasks/*.ts Grunttasks.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seo-rii/doppio.git"
  },
  "bin": {
    "doppio": "./bin/doppio",
    "doppioh": "./bin/doppioh",
    "doppio-dev": "./bin/doppio-dev",
    "doppio-fast-dev": "./bin/doppio-fast-dev"
  }
}
