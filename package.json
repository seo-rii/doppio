  "scripts": {
    "test": "grunt test",
    "prepublish": "node ./prepublish.js",
    "install": "node ./install.js",
    "appveyor-test": "grunt --stack test-browser-appveyor",
    "site:browser-test": "node ci/pages_browser_smoke.mjs",
    "site:build": "vite build --config vite.site.config.mjs",
    "site:check": "node ci/check_pages_site.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:bootstrap": "tsc --noEmit --ignoreConfig --noImplicitAny --noImplicitThis false --strict false --strictNullChecks false --strictPropertyInitialization false --useUnknownInCatchVariables false --module commonjs --target ES2015 --skipLibCheck types/legacy-globals.d.ts tasks/*.ts Grunttasks.ts",
    "typecheck:typescript-7-rc": "npx -y -p typescript@7.0.1-rc tsc --project tsconfig.json --noEmit",
    "typecheck:typescript-7-rc-bootstrap": "npx -y -p typescript@7.0.1-rc tsc --noEmit --ignoreConfig --noImplicitAny --noImplicitThis false --strict false --strictNullChecks false --strictPropertyInitialization false --useUnknownInCatchVariables false --module commonjs --target ES2015 --skipLibCheck types/legacy-globals.d.ts tasks/*.ts Grunttasks.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seo-rii/doppio.git"
  },
  "bin": {
    "doppio": "./bin/doppio",
    "doppioh": "./bin/doppioh",
    "doppio-dev": "./bin/doppio-dev",
    "doppio-fast-dev": "./bin/doppio-fast-dev"
  }
